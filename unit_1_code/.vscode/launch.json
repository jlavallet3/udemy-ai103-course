        {
            "name": "Python Debugger: LLM Execution",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/llm_execution.py",
            "console": "integratedTerminal",
            "python": "tutorials/Scripts/python.exe",
            "env": {
                "OPENAI_ENDPOINT": "https://courseunit696.services.ai.azure.com/openai/v1",
                "MODEL_DEPLOYMENT_NAME": "courseunit696-llm-deploy",
            }
        },
    ]
}
